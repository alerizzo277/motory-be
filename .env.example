POSTGRES_DB=motory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motory
JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
JWT_EXPIRES_IN=3600
RESEND_API_KEY=re_replace_me
MAIL_FROM=Motory <noreply@example.com>
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
VEHICLE_DELETION_RETENTION_DAYS=90
# NODE_ENV: development (default), production or test.
# Development uses readable logs through log; production uses JSON through warn.
# Test logging is disabled unless LOG_LEVEL is explicitly set.
NODE_ENV=development
# LOG_LEVEL minimum severity: fatal, error, warn, log, debug or verbose.
# Leave unset to use the environment default.
# LOG_LEVEL=log
